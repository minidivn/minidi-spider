# Generic: Sports entities (teams, athletes, venues, leagues).
# {COUNTRY_QID} {LANG} {FILTER} {LIMIT}
SELECT DISTINCT ?item ?itemLabel ?itemDescription ?type ?typeLabel WHERE {
  VALUES ?country { wd:{COUNTRY_QID} }
  { ?item wdt:P17 ?country . ?item wdt:P106 wd:Q2066131 . }    # athlete
    UNION
  { ?item wdt:P17 ?country . ?item wdt:P31 wd:Q476028 . }      # sports team
    UNION
  { ?item wdt:P17 ?country . ?item wdt:P31 wd:Q15911547 . }    # sports venue
  OPTIONAL { ?item wdt:P31 ?type . }
  {FILTER}
  SERVICE wikibase:label { bd:serviceParam wikibase:language "{LANG},en" . }
}
LIMIT {LIMIT}
