# Generic: Organizations (companies, universities, NGOs, etc).
# {COUNTRY_QID} {LANG} {FILTER} {LIMIT}
SELECT DISTINCT ?item ?itemLabel ?itemDescription ?type ?typeLabel ?founded WHERE {
  VALUES ?country { wd:{COUNTRY_QID} }
  ?item wdt:P17 ?country .
  { ?item wdt:P31 wd:Q4830453 . }     # business
    UNION
  { ?item wdt:P31 wd:Q3918 . }        # university
    UNION
  { ?item wdt:P31 wd:Q6881511 . }     # non-profit
    UNION
  { ?item wdt:P31 wd:Q7278 . }        # political party
  OPTIONAL { ?item wdt:P571 ?founded . }
  {FILTER}
  SERVICE wikibase:label { bd:serviceParam wikibase:language "{LANG},en" . }
}
LIMIT {LIMIT}
