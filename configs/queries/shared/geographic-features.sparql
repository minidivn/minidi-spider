# Generic: Geographic features (rivers, mountains, lakes, islands).
# {COUNTRY_QID} {LANG} {FILTER} {LIMIT}
SELECT DISTINCT ?item ?itemLabel ?itemDescription ?type ?typeLabel ?coord ?elevation WHERE {
  VALUES ?country { wd:{COUNTRY_QID} }
  ?item wdt:P17 ?country .
  { ?item wdt:P31 wd:Q4022 . }        # river
    UNION
  { ?item wdt:P31 wd:Q8502 . }        # mountain
    UNION
  { ?item wdt:P31 wd:Q23397 . }       # lake
    UNION
  { ?item wdt:P31 wd:Q23442 . }       # island
    UNION
  { ?item wdt:P31 wd:Q159334 . }      # mountain range
    UNION
  { ?item wdt:P31 wd:Q37853 . }       # bay / gulf
  OPTIONAL { ?item wdt:P625 ?coord . }
  OPTIONAL { ?item wdt:P2044 ?elevation . }
  {FILTER}
  SERVICE wikibase:label { bd:serviceParam wikibase:language "{LANG},en" . }
}
LIMIT {LIMIT}
